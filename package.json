{
  "name": "meal-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-fetch.mjs",
    "dev": "next dev",
    "build": "tsx scripts/check-dietary-profiles.ts && next build && node scripts/verify-ai-runtime-trace.mjs",
    "start": "next start",
    "postinstall": "node scripts/copy-zxing-wasm.mjs",
    "lint": "eslint --max-warnings 0 && pnpm lint:docs",
    "lint:docs": "tsx scripts/check-features.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:branch": "bash scripts/db-branch.sh create",
    "db:reset": "bash scripts/db-branch.sh reset",
    "db:push": "bash -c 'supabase db push --db-url \"$SUPABASE_TEST_DB_URL\"'",
    "test:integration": "vitest run --config vitest.integration.config.ts --no-file-parallelism",
    "ai:canary": "tsx scripts/ai-canary.ts",
    "timings": "tsx scripts/timings.ts",
    "timings:ai": "tsx scripts/ai-calls-timings.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "idb": "^8.0.4",
    "leaflet": "1.9.4",
    "lucide-react": "^1.54.0",
    "mcp-handler": "^2.3.0",
    "motion": "^14.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "1.9.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "shadcn": "^4.21.4",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.25.0"
}

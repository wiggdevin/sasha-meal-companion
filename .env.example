# Copy to .env.local for local dev. Never commit .env.local.
# Production values live in Vercel project settings, not in git.

# --- Supabase --------------------------------------------------------------
# Project fivatgdpuenszxxnijpc (Zerosumsolutions-Projects).

# Server-side project URL. [in use today — server routes]
SUPABASE_URL=https://your-project.supabase.co

# Server-only key. Full read/write, bypasses RLS. Never expose to the client.
# [in use today — privileged server helpers]
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public project URL for browser-side Supabase auth. [reserved for Phase 0]
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public, low-privilege key for browser-side Supabase auth. [reserved for Phase 0]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Integration tests -------------------------------------------------------
# Printed by `pnpm db:branch` / `bash scripts/db-branch.sh env <branch>`. tests/ skip every
# suite when SUPABASE_TEST_URL is unset.

# Test branch project URL. [reserved for Phase 0]
SUPABASE_TEST_URL=https://your-test-branch.supabase.co

# Test branch anon key. [reserved for Phase 0]
SUPABASE_TEST_ANON_KEY=your-test-anon-key

# Test branch service role key. [reserved for Phase 0]
SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-service-role-key

# Test branch direct Postgres URL, for `pnpm db:push`. [reserved for Phase 0]
SUPABASE_TEST_DB_URL=postgres://...

# auth.users id of a throwaway local test user.
# [reserved for Phase 0]
SUPABASE_TEST_USER_ID=your-test-user-id

# --- Catalog import (Phase 1) -----------------------------------------------
# Direct Postgres URL for the import worker (scripts/import-fdc.py). [worker only — never Vercel]
CATALOG_IMPORT_DB_URL=postgres://...

# --- Search relevance eval (Phase 1) -----------------------------------------
# Supabase branch test-user credentials for scripts/search-eval.ts. [eval only — never Vercel]
SEARCH_EVAL_EMAIL=your-eval-user@example.com
SEARCH_EVAL_PASSWORD=your-eval-user-password

# --- Barcode providers (Phase 3) ----------------------------------------------
# USDA FoodData Central API key, for FDC Branded barcode lookup (lib/catalog/fdc.ts).
# [reserved for Phase 3]
FDC_API_KEY=your-fdc-api-key

# --- AI ----------------------------------------------------------------------
# Gemini API key. [reserved for Phase N]
GEMINI_API_KEY=your-gemini-key

# TypeSafe Jev API key. Server-only; never expose it with a NEXT_PUBLIC_ prefix.
# ZS Vault entry: typesafe_api_key.
TYPESAFE_API_KEY=

# Jev optionally pre-classifies coach intent, ranks code-built suggestions, parses dietary text,
# and verifies replies. Missing credentials, timeouts, provider errors, and malformed answers all
# fall through to the Gemini or deterministic path; Jev is never required for a user action.

# Model ids are pinned as literals in lib/ai/lanes.ts, never env vars or "latest" aliases.
# lib/ai/models.ts reads those pins and re-exports the existing model names.

# Coach defaults to Gemini and can use OpenRouter when configured below. Weekly review runs on
# Gemini. The app has no Nous Portal transport (removed 2026-10-01; docs/ai-data-handling.md).

# Gemini attestation (lib/ai/attestation.ts). Since Phase 13 slice 0 this pair gates every Gemini
# call that carries user content, not only health-context turns: coach turns, the weekly review,
# all four capture methods, dictation, live voice, and media upload signing. Calls with no user
# content (D0) do not need it. Both halves are manual and never inferred. With either one unset,
# those routes answer 503 nous_unconfirmed, so a production deploy must set both.
# Set them only after Gemini billing and prompt-logging are confirmed in the console. [Phase 13]
# HEALTH_CONTEXT_PROVIDER=gemini
# GEMINI_BILLING_ATTESTED=1

# OpenRouter (owner request 2026-10-02, docs/ai-data-handling.md "OpenRouter"): lib/ai/openrouter.ts
# is the coach's capacity fallback — and, with COACH_PROVIDER below, its primary — governed by the
# same callModel path as Gemini. Server-only; never expose it with a NEXT_PUBLIC_ prefix.
# ZS Vault entry: openrouter_api_key.
OPENROUTER_API_KEY=

# OpenRouter attestation, mirroring the Gemini pair above under its own name. OpenRouter forwards
# every request to a third party (whichever model the slug names), so it needs the same manual,
# never-inferred sign-off before a D1/D2 call can carry user content through it — read OpenRouter's
# own privacy terms first; see docs/ai-data-handling.md "OpenRouter" before setting this in
# production. Unset, every OpenRouter call (fallback or primary) answers 503 nous_unconfirmed.
# OPENROUTER_ATTESTED=1

# Which provider answers the coach's PRIMARY turn: "google" (unset, or anything but "openrouter")
# keeps the pinned Gemini lane exactly as it was; "openrouter" sends it through lib/ai/openrouter.ts
# with the OpenRouter model id pinned in lib/ai/lanes.ts. Model changes go through a PR.
# COACH_PROVIDER=google

# The OpenRouter coach fallback, plan photo/document, and capture model ids are also pinned in
# lib/ai/lanes.ts. OpenRouter calls require the key and attestation above. Voice stays on Gemini.

# Per-account daily ceiling on AI spend (UTC day), in US dollars. Default 2; 0 stops every
# model call. Enforced by an atomic reservation in Postgres (lib/ai/spend.ts, scale S2).
AI_DAILY_SPEND_CAP_USD=2

# Whole-deployment daily ceiling on AI spend across every account (UTC day), in US dollars.
# Default 50. A call is refused (429 spend_cap) when its reserved cost would pass either cap.
# Bounded overshoot: a cap can be exceeded by at most one call's overrun beyond its estimate
# (and the global ceiling also by the holds in flight at that moment).
AI_GLOBAL_DAILY_SPEND_CAP_USD=50

# The allowance one OpenRouter attempt reserves against the caps above (this app keeps no
# OpenRouter price table, so it is configured, not computed). Must be > 0; default 0.25. An attempt
# that costs more is recorded in full and logged.
AI_OPENROUTER_ATTEMPT_CEILING_USD=0.25

# --- Jobs ----------------------------------------------------------------------
# Shared secret for scheduled/cron job requests. [reserved for Phase N]
CRON_SECRET=your-cron-secret

# --- Health --------------------------------------------------------------------
# Oura Ring OAuth client id. [reserved for Phase N]
OURA_CLIENT_ID=your-oura-client-id

# Oura Ring OAuth client secret. [reserved for Phase N]
OURA_CLIENT_SECRET=your-oura-client-secret

# Oura Ring OAuth redirect URI. [reserved for Phase N]
OURA_REDIRECT_URI=https://meal-companion.example/api/health/oura/callback

# AES-256-GCM key that seals Oura OAuth tokens before they reach Postgres (lib/server/crypto.ts).
# 32 random bytes, base64. [reserved for Phase 5]
HEALTH_TOKEN_KEY=32-random-bytes-base64

# IANA timezone used to bucket health samples into local days (lib/server/health-ingest.ts).
# Defaults to UTC when unset. [reserved for Phase 5]
HEALTH_TZ=

# Public iCloud link for the ready-made Apple Health Shortcut. Empty keeps manual setup visible.
NEXT_PUBLIC_APPLE_HEALTH_SHORTCUT_URL=

# --- Feature flags -----------------------------------------------------------
# Each defaults off. Server-side flags take effect on the next request. NEXT_PUBLIC_* flags are
# baked into the browser bundle at `next build`, so turning one off needs a redeploy (Vercel →
# Redeploy, or an empty commit); the server-side guard behind each feature still refuses
# requests immediately, so the UI can show a stale button but nothing runs.

# Serves catalog search results in the log sheet instead of the bundled food-db. [reserved for Phase 1]
NEXT_PUBLIC_CATALOG_SEARCH=

# Server-side scan capability. NEXT_PUBLIC_FEATURE_SCAN is retained as a one-release fallback
# while the current Vercel value moves to FEATURE_SCAN. [reserved for Phase 3]
FEATURE_SCAN=
NEXT_PUBLIC_FEATURE_SCAN=

# Comma list of enabled AI capture methods (text, voice, label, photo), read at module load by
# lib/capture/flags.ts; a method absent from the list renders no action. [reserved for Phase 4]
CAPTURE_METHODS=

# The same list as CAPTURE_METHODS, baked into the client bundle at build time so the capture
# actions render for enabled methods only. Set both to the same value. [reserved for Phase 4]
NEXT_PUBLIC_CAPTURE_METHODS=

# Per-user successful proposes per local day before a warning note is added to the response.
# Default 30. [reserved for Phase 4]
CAPTURE_DAILY_SOFT_CAP=

# Set to 0 to stop all AI capture provider spend while leaving Phase 2 search intact.
# [reserved for Phase 4]
CAPTURE_DAILY_HARD_CAP=

# Gates /api/health/ingest and the Oura routes; returns 503 and no-ops the poll job when unset.
# [reserved for Phase 5]
HEALTH_INGEST_ENABLED=

# These gates turn on only for the literal string "true"; unset, empty, "1", and "false" stay off.
NEXT_PUBLIC_ACTIVITY_PROMPT_UI=
COACH_ACTIVITY_CONTEXT_ENABLED=

# Server-side: runs the nightly estimate and weekly-proposal jobs. [reserved for Phase 6]
ESTIMATOR_ENABLED=

# Client-side: renders the estimator card and the proposal card. [reserved for Phase 6]
NEXT_PUBLIC_ESTIMATOR_UI=

# Gates the Coach FAB, screen, and every /api/coach* route. The server layout serializes this one
# value into the app capabilities context; missing means unavailable. [reserved for Phase 7]
COACH_ENABLED=

# Medical condition packs in dietary profiles (lib/policy/profiles/condition-packs.ts). Offered
# only when exactly 1; ships unset until the owner reviews the pack wording on a Preview. [Phase 13]
CONDITION_PACKS_ENABLED=

# --- Recipe pilot ------------------------------------------------------------
# Comma-separated account UUIDs allowed into the recipe planning and Shopping workflows, or "*" for
# every account. Unset or empty keeps production closed (lib/server/recipe-access.ts). This is a
# rollout control, not a content boundary: published original recipes stay readable through RLS.
RECIPE_PLANNING_USER_IDS=

# --- Open-world foods (Phase 18 W2b) ------------------------------------------
# POST /api/foods/world opens an account's food world only when exactly 1 (lib/foods/world/access.ts).
# Ships unset: no account opens until the universe review (owner decision Q3) and the safety gates pass.
OPEN_WORLD_ENABLED=
# Staged release: comma-separated account UUIDs (or "*") the flag opens for. Unset or empty: the flag
# alone decides. While it lists anyone, every other account stays closed: no opt-in, no invitation and
# no onboarding open default (lib/foods/world/access.ts).
OPEN_WORLD_USER_IDS=
# Comma-separated account UUIDs held closed with no invitation even once released (decision Q5).
OPEN_WORLD_HOLD_USER_IDS=

# --- Free-text taste chips (Phase 18 W5b) -------------------------------------
# POST /api/profile/prefs { taste } and the coach's taste chip card run only when exactly 1
# (lib/server/taste-chips.ts). Ships unset until the UI lane ships the taste field and the card.
# The taste safety check on every other Jev path is always on.
TASTE_CHIPS_ENABLED=

# --- Rebalance panel (Phase 19) ---------------------------------------------
# Comma-separated account UUIDs that see the read-only "rebalance my day" panel, or "*" for every
# account. Unset or empty is off everywhere, including development (lib/server/rebalance-access.ts).
# Set it only after the D6 clinical sign-off is recorded in docs/decisions/.
REBALANCE_PANEL_USER_IDS=

# --- Media -----------------------------------------------------------------
# The media bucket is NOT an env var. phase-4-ai-capture.md's storage.buckets migration hardcodes
# the bucket id and name as the literal 'media', and no code reads process.env.SUPABASE_MEDIA_BUCKET.
# The bucket name is a fixed constant, not configuration.

# --- Local development only ----------------------------------------------------
# GET /api/dev/sign-in signs the dev server in as this user with no email round trip. The route
# answers 404 in production and on every Vercel environment; never set this in Vercel.
DEV_SIGN_IN_EMAIL=

# Local only: open the /design fixture galleries without signing in (next dev). Never set in a deployment.
# NEXT_PUBLIC_DESIGN_GALLERY_OPEN=1

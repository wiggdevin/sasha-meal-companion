exports[`draft editor fields > keeps every barcode confirmation field, the no ingredient list warning included, in the extracted editor 1`] = `"<div class="flex flex-col gap-4"><div class="flex items-center justify-between gap-3"><span class="pill inline-flex"><span class="pill-in  flex h-[30px] items-center px-3 text-tiny font-normal text-amber">No ingredient list — check the pack</span></span><button type="button" aria-label="Favourite this food" aria-pressed="false" class="tap flex items-center justify-center rounded-full text-graphite" style="width:44px;height:44px"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.7l5.9-.9z"></path></svg></button></div><div class="flex flex-col gap-2"><span class="text-tiny font-normal text-graphite">Portion</span><div class="flex flex-wrap gap-2"><div class="pill inline-flex"><button type="button" aria-pressed="true" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-on-primary" style="min-height:44px;min-width:44px;background:var(--grad-ink)">30 g · 6 crackers</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">100 g</button></div></div></div><div><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2"><span class="min-w-0 break-words text-body font-medium text-charcoal">How many</span><div class="pill ml-auto inline-flex shrink-0"><div class="pill-in flex items-center"><button type="button" aria-label="Decrease How many" class="flex items-center justify-center disabled:opacity-40 rounded-full text-graphite text-subheading font-normal" style="width:44px;height:44px">−</button><span aria-live="polite" class="text-center tabular-nums text-caption font-normal text-charcoal" style="min-width:76px">1</span><button type="button" aria-label="Increase How many" class="flex items-center justify-center disabled:opacity-40 rounded-full text-graphite text-subheading font-normal" style="width:44px;height:44px">+</button></div></div></div><p class="mt-1 text-tiny font-normal text-muted">30 g</p></div><div class="flex flex-col gap-2"><span class="text-tiny font-normal text-graphite">Slot</span><div class="flex flex-wrap gap-2"><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 1</button></div><div class="pill inline-flex"><button type="button" aria-pressed="true" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-on-primary" style="min-height:44px;min-width:44px;background:var(--grad-ink)">Meal 2</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 3</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 4</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 5</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 6</button></div></div></div><div class="flex flex-col gap-1"><span class="text-tiny font-normal text-graphite">Ingredients</span><p class="m-0 text-tiny font-normal text-muted">Rice, sea salt</p></div><p class="m-0 text-tiny font-normal text-muted">Open Food Facts</p><div class="flex flex-col gap-2 pt-1"><button type="button" class="btn-ink tap w-full disabled:opacity-40 text-body! font-medium!" style="height:52px;box-shadow:var(--shadow-button)">Log it</button><button type="button" class="tap h-11 self-center px-4 disabled:opacity-40 text-tiny font-normal text-graphite">Search manually</button><button type="button" class="tap h-11 self-center px-4 disabled:opacity-40 text-tiny font-normal text-graphite">Dismiss</button></div></div>"`;

exports[`draft editor fields > keeps every capture confirmation field, the try another match row included, in the extracted editor 1`] = `"<div class="flex flex-col gap-3 px-1"><p class="text-tiny font-normal text-muted">Check the amount.</p><div style="background:var(--grad-card);box-shadow:var(--shadow-card)" class="flex flex-col gap-3 px-3.5 py-3 rounded-2xl"><div class="flex items-start justify-between gap-3"><div class="flex min-w-0 flex-col gap-0.5"><span class="truncate text-caption font-normal">Roast chicken</span><span class="text-tiny font-normal text-graphite">Best guess. Check it.</span></div><span class="pill inline-flex shrink-0"><span class="pill-in flex h-8 items-center gap-1.5 px-3"><span class="rounded-full" style="width:6px;height:6px;background:var(--color-muted)"></span><span class="text-tiny font-normal text-graphite">Not checked</span></span></span></div><div><div><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2"><span class="min-w-0 break-words text-body font-medium text-charcoal">Grams</span><div class="pill ml-auto inline-flex shrink-0"><div class="pill-in flex items-center"><button type="button" aria-label="Decrease Grams" class="flex items-center justify-center disabled:opacity-40 rounded-full text-graphite text-subheading font-normal" style="width:44px;height:44px">−</button><span aria-live="polite" class="text-center tabular-nums text-caption font-normal text-charcoal" style="min-width:76px">120 g</span><button type="button" aria-label="Increase Grams" class="flex items-center justify-center disabled:opacity-40 rounded-full text-graphite text-subheading font-normal" style="width:44px;height:44px">+</button></div></div></div></div></div><div class="flex flex-col gap-2"><span class="text-tiny font-normal text-graphite">Portion</span><div class="flex flex-wrap gap-1.5"><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">one palm · 100 g</button></div></div></div><div class="flex flex-col gap-2"><span class="text-tiny font-normal text-graphite">Try another match</span><div class="flex flex-wrap gap-1.5"><div class="pill inline-flex"><button type="button" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Chicken breast</button></div></div></div><button type="button" class="tap h-11 self-start px-1 text-left text-tiny font-normal text-graphite">Remove</button></div><div class="flex flex-col gap-2"><span class="text-tiny font-normal text-graphite">Slot</span><div class="flex flex-wrap gap-2"><div class="pill inline-flex"><button type="button" aria-pressed="true" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-on-primary" style="min-height:44px;min-width:44px;background:var(--grad-ink)">Meal 1</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 2</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 3</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 4</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 5</button></div><div class="pill inline-flex"><button type="button" aria-pressed="false" class="pill-in tap flex items-center justify-center px-4 text-tiny font-normal text-graphite" style="min-height:44px;min-width:44px">Meal 6</button></div></div></div><div class="flex flex-col gap-2 pt-1"><button type="button" class="btn-ink tap w-full disabled:opacity-40 text-body! font-medium!" style="height:52px;box-shadow:var(--shadow-button)">Log it</button><button type="button" class="tap h-11 self-center px-4 disabled:opacity-40 text-tiny font-normal text-graphite">Search manually</button><button type="button" class="tap h-11 self-center px-4 disabled:opacity-40 text-tiny font-normal text-graphite">This was a nutrition label</button><button type="button" class="tap h-11 self-center px-4 disabled:opacity-40 text-tiny font-normal text-graphite">Dismiss</button></div></div>"`;
